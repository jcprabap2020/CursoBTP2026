@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Auto',
    typeNamePlural: 'Autos',
    typeImageUrl: '',
    imageUrl: 'imagen',
    title: {
        type: #STANDARD,
        label: 'YYYYYYYYYY',
        value: 'Marca',
        iconUrl: ''
        },
    description: {
        type: #STANDARD,
        label: 'XXXXXXXXXXXXXX',
        iconUrl: '',
        criticality: '',
        criticalityRepresentation: #WITHOUT_ICON,
        value: 'Modelo',
        valueQualifier: '',
        targetElement: '' }
}
@Search.searchable: true
annotate entity zcds_renting_jp
    with 
{
//cuadro que lista algunas caracteristicas
  @UI.facet: [{ id: 'DetAuto', label: 'Detalle Auto', type : #COLLECTION, position : 10 },
              { id: 'vehiculo',label: 'Detalles',  parentId: 'DetAuto',  type: #FIELDGROUP_REFERENCE,
                    targetQualifier: 'DetAuto', position: 10}]
  @UI.fieldGroup: [{ qualifier: 'DetAuto', position: 10 }]
  matricula;
  @UI.fieldGroup: [{ qualifier: 'DetAuto', position: 20 }]
  Combustible;
  @UI.fieldGroup: [{ qualifier: 'DetAuto', position: 30 }]
  Consumo;
  @UI.fieldGroup: [{ qualifier: 'DetAuto', position: 40 }]
  FechaFabr;
  @UI.fieldGroup: [{ qualifier: 'DetAuto', position: 50 }]
  Puertas;
// listado detalle cliente
  @UI.facet: [{ id: 'cliente', label: 'Clientes', type :#LINEITEM_REFERENCE, targetElement: '_det', position:20  }]
  
//Pagina principal-----------------------------------------------------------------------------
  @UI.lineItem: [{ position: 10, importance: #HIGH, cssDefault.width: '100px' }]
  @UI.selectionField: [{ position: 10 }] 
  @Search: {
      defaultSearchElement: true,
      ranking: #MEDIUM,
      fuzzinessThreshold: 0.8
  }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'zcds_brands_jp', element: 'marca'  } }]
  marca;
//  -------------------
  @UI.lineItem: [{ position: 20, importance: #HIGH, cssDefault.width: '140px' }]
  @Search: {
      defaultSearchElement: true,
      ranking: #MEDIUM,
      fuzzinessThreshold: 0.8
  }
  modelo;
//-------------------------
  @UI.lineItem: [{ position: 30, importance: #HIGH, cssDefault.width: '100px' }]
  color;
//---------------------------
  @UI.lineItem: [{ position: 40, importance: #HIGH, label: 'Motor', cssDefault.width: '80px' }]
  motor;
//---------------------------
  @UI.lineItem: [{ position: 50, importance: #HIGH, cssDefault.width: '80px' }]
  Potencia;
//---------------------------
  @UI.lineItem: [{ position: 60, importance: #HIGH, cssDefault.width: '80px' }]
  @UI.selectionField: [{ position: 20 }] 
  Precio;
//---------------------------
  @UI.lineItem: [{ position: 70, importance: #HIGH, cssDefault.width: '80px' }]
  Moneda;
//---------------------------
  @UI.lineItem: [{ position: 80, importance: #HIGH, cssDefault.width: '80px' }]
  Alquilado;
//---------------------------
  @UI.lineItem: [{ position: 90, importance: #HIGH, cssDefault.width: '150px' }]
  termino;
//---------------------------


}